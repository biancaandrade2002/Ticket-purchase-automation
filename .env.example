# ============================================
# TEMPLATE DE CONFIGURACAO
# Copie este arquivo para ".env" e preencha com seus dados reais.
# NUNCA comite o arquivo .env (ele ja esta no .gitignore).
#   Windows PowerShell:  Copy-Item .env.example .env
# ============================================

# --- Credenciais BuyTicket ---
# Login de 2 etapas: CPF (etapa 1) + senha (etapa 2).
# Se BUYTICKET_CPF não estiver definido, usa a variável CPF (dados pessoais).
BUYTICKET_CPF=00000000000
BUYTICKET_EMAIL=seuemail@exemplo.com   # legado — não mais usado no login
BUYTICKET_SENHA=sua_senha_buyticket

# URLs do evento BuyTicket (opcionais — o bot usa os valores padrão se omitidos).
# Útil para adaptar a outros eventos: altere as URLs sem modificar o código.
# BUYTICKET_URL_BASE=https://buyticketbrasil.com/event/slug-do-evento
# BUYTICKET_LOGIN_URL=https://buyticketbrasil.com/entrar
# BUYTICKET_URL_CONTA=https://buyticketbrasil.com/minha-conta
# BUYTICKET_DOMINIO=buyticketbrasil.com
# BUYTICKET_URLS=https://buyticketbrasil.com/event/slug/session/UUID-dia1,https://buyticketbrasil.com/event/slug/session/UUID-dia2,https://buyticketbrasil.com/event/slug/session/UUID-dia3

# --- Credenciais Ticketmaster ---
TICKETMASTER_EMAIL=seuemail@exemplo.com
TICKETMASTER_SENHA=sua_senha_ticketmaster

# URLs Ticketmaster (opcionais — o bot usa os valores padrão se omitidos).
# TICKETMASTER_URL_HOME=https://www.ticketmaster.com.br/
# TICKETMASTER_DOMINIO=www.ticketmaster.com.br
# TICKETMASTER_URLS=https://www.ticketmaster.com.br/event/slug-dia1,https://www.ticketmaster.com.br/event/slug-dia2,https://www.ticketmaster.com.br/event/slug-dia3

# Datas dos shows (opcional — padrão: 28/10,30/10,31/10).
# DATAS_SHOW=DD/MM,DD/MM,DD/MM

# --- Dados Pessoais (Preenchimento Automatico no checkout) ---
NOME_COMPLETO=Seu Nome Completo
CPF=00000000000
RG=000000000
DATA_NASCIMENTO=01/01/1990
EMAIL=seuemail@exemplo.com
TELEFONE=11999999999
CEP=00000000
ENDERECO=Rua Exemplo
NUMERO=100
COMPLEMENTO=Apto 1
BAIRRO=Centro
CIDADE=Sua Cidade
ESTADO=SP

# --- Notificacao por Email (Gmail) ---
# Precisa ser Gmail com Senha de App (nao a senha normal da conta).
# Gerar Senha de App: https://myaccount.google.com/apppasswords
EMAIL_REMETENTE=seuemail@gmail.com
EMAIL_SENHA_APP=sua_senha_de_app_google
EMAIL_DESTINATARIO=seuemail@gmail.com

# --- Notificacao por SMS/WhatsApp (Twilio) ---
TWILIO_ACCOUNT_SID=seu_account_sid
TWILIO_AUTH_TOKEN=seu_auth_token
TWILIO_PHONE_FROM=+15551234567
TWILIO_PHONE_TO=+5511999999999

# --- Notificacao WhatsApp via CallMeBot (GRATIS) ---
CALLMEBOT_PHONE=5511999999999
CALLMEBOT_APIKEY=sua_api_key

# --- Notificacao via Telegram (GRATIS) ---
TELEGRAM_BOT_TOKEN=seu_bot_token
TELEGRAM_CHAT_ID=seu_chat_id

# --- Notificacao via ntfy.sh (MAIS FACIL - Zero cadastro) ---
# Escolha um topico unico e dificil de adivinhar (funciona como uma senha).
NTFY_TOPIC=escolha-um-topico-unico-e-secreto

# --- Notificacao no NOTEBOOK via ntfy.sh ---
# Deixe em branco para desativar.
NTFY_TOPIC_PC=escolha-um-topico-notebook-secreto

# --- Datas dos shows (opcional — padrão: 28/10,30/10,31/10) ---
# Altere para adaptar a outros eventos nos mesmos sites.
# DATAS_SHOW=DD/MM,DD/MM,DD/MM

# --- Limites de preço por setor (opcional — padrão: 999999 = sem limite) ---
# Descomente e ajuste para ativar limite. Setores compostos usam underscore.
# LIMITE_SOUNDCHECK_INTEIRA=999999
# LIMITE_SOUNDCHECK_MEIA=999999
# LIMITE_PISTA_INTEIRA=5000
# LIMITE_PISTA_MEIA=1000
# LIMITE_CADEIRA_INFERIOR_INTEIRA=1100
# LIMITE_CADEIRA_INFERIOR_MEIA=700
# LIMITE_CADEIRA_SUPERIOR_INTEIRA=900
# LIMITE_CADEIRA_SUPERIOR_MEIA=600
# LIMITE_ARQUIBANCADA_INTEIRA=600
# LIMITE_ARQUIBANCADA_MEIA=500

# --- Configuracoes do Monitor ---
INTERVALO_CHECK_MS=3000
HEADLESS=false
MINIMIZED=true
START_MINIMIZED=true
CDP_BLOQUEIO=true
DRY_RUN=false
INTERVALO_CHECK_LOGIN_S=3600

# Monitor ativo: qual(is) site(s) o bot deve monitorar.
# 'ambos'        → monitora BuyTicket e Ticketmaster (padrao)
# 'buyticket'    → somente BuyTicket
# 'ticketmaster' → somente Ticketmaster
MONITOR_ONLY=ambos
